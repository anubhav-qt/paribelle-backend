# Test Environment Configuration (Production-like)
# Copy to .env.test and use with: NODE_ENV=test npm run start:dev

NODE_ENV=test
PORT=3001

# Database - Use a separate test database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=admin
DB_DATABASE=marketplace_test

# Use production-like settings
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=true

# JWT
JWT_SECRET=your-test-jwt-secret-key-here
JWT_EXPIRATION=7d

# Other settings...
