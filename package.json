{
  "name": "backend",
  "version": "1.0.0",
  "description": "GaliCart marketplace backend API",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "build:prod": "nest build",
    "postinstall": "npm install --include=optional sharp",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node start-prod.js",
    "start:prod:init": "node initialsetup/init-database.js --create-database --force && node start-prod.js",
    "render:build": "npm install && npm run build",
    "render:drop": "node render-drop-tables.js",
    "render:create_tables": "node render-create-tables.js",
    "render:seed_data": "node seed-all-render.js",
    "render:start": "node run-migrations.js && node dist/main",
    "_render:start:first_time_with_data": "npm run render:create_tables && npm run render:seed_data && node dist/main",
    "_render:start:first_time_no_data": "npm run render:create_tables && node dist/main",
    "test:node": "node test-node.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "migration:creation": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create",
    "db:init": "node initialsetup/init-database.js",
    "db:init:create": "node initialsetup/init-database.js --create-database",
    "seed": "ts-node -r tsconfig-paths/register src/database/seed-runner.ts",
    "seed:admin": "ts-node -r tsconfig-paths/register src/scripts/seed-admin.ts",
    "seed:tours": "node seed-tour-products.js",
    "seed:services": "node seed-service-products.js",
    "seed:physical": "node seed-physical-products.js",
    "seed:all": "npm run seed && npm run seed:tours && npm run seed:services && npm run seed:physical",
    "migrate:reviews-cascade": "node add-cascade-delete-reviews.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.490.0",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/platform-socket.io": "^10.4.20",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.1",
    "@nestjs/websockets": "^10.4.20",
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^7.0.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/qrcode": "^1.5.6",
    "@types/xlsx": "^0.0.35",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "bcrypt": "^5.1.1",
    "cache-manager": "^7.2.7",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cloudinary": "^2.8.0",
    "compression": "^1.7.4",
    "exceljs": "^4.4.0",
    "express-rate-limit": "^7.1.5",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.11",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.2",
    "redis": "^3.1.2",
    "reflect-metadata": "^0.2.1",
    "rimraf": "^6.1.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.19",
    "typeorm-naming-strategies": "^4.1.0",
    "typescript": "^5.3.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.4.20",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.11",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^6.4.21",
    "@types/passport-jwt": "^4.0.0",
    "@types/passport-local": "^1.0.38",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=18.0.0 <=22.x",
    "npm": ">=9.0.0"
  }
}
