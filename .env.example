# Application
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=marketplace

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d

# Razorpay (Optional - configure later)
# RAZORPAY_KEY_ID=your_razorpay_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Cloudinary (Optional - configure later)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# AWS S3 (alternative to Cloudinary)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name

# Email (SMTP) — used for signup verification, order status, password reset
# and return/KYC notifications. A transactional provider (Brevo, Resend,
# SendGrid, Mailgun) is recommended over a personal Gmail account: better
# deliverability, no App Password dance, and no per-account rate limit.
# Whichever you use, verify the sending domain (SPF + DKIM) or mail will land
# in spam regardless of these settings being correct.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="PariBelle <noreply@paribelle.in>"

# Shown in every email's branding and subject line.
APP_NAME=PariBelle

# Admin Email (for KYC document notifications and admin alerts)
ADMIN_EMAIL=admin@marketplace.com

# Frontend URLs (for CORS)
# Development: Use localhost
# Production: Use your Vercel deployment URLs
# Note: Vercel preview deployments (*.vercel.app) are automatically allowed by the CORS logic
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006,http://localhost:3001

# Web App URL (Frontend)
# Development: http://localhost:3000
# Production: https://marketplace-web-smoky.vercel.app
WEB_APP_URL=http://localhost:3000

# Application URL (for emails and links)
# Development: http://localhost:3000
# Production: https://marketplace-web-smoky.vercel.app
APP_URL=http://localhost:3000

# Frontend URL (for admin review links in emails)
# Should match your web app URL
FRONTEND_URL=http://localhost:3000

# Admin Settings
DEFAULT_COMMISSION_RATE=10.0
