# Application
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=marketplace

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d

# Razorpay (Optional - configure later)
# RAZORPAY_KEY_ID=your_razorpay_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Cloudinary (Optional - configure later)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# AWS S3 (alternative to Cloudinary)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name

# Email — used for signup verification, order status, password reset and
# return/KYC notifications. Sent via Brevo's HTTP API, not SMTP: Render's
# free tier blocks all outbound SMTP ports (25/465/587) platform-wide, which
# an SMTP transport hits as a connection timeout no matter whose server or
# credentials are on the other end. HTTPS isn't blocked, so Brevo's API
# works from the free tier. Get BREVO_API_KEY from Brevo → Settings →
# SMTP & API → API Keys. Whichever sender address you use, verify the
# sending domain (SPF + DKIM) in Brevo or mail will land in spam regardless
# of everything else being correct.
BREVO_API_KEY=your-brevo-api-key
SMTP_FROM="PariBelle <noreply@paribelle.in>"

# Shown in every email's branding and subject line.
APP_NAME=PariBelle

# Admin Email (for KYC document notifications and admin alerts)
ADMIN_EMAIL=admin@marketplace.com

# Frontend URLs (for CORS)
# Development: Use localhost
# Production: Use your Vercel deployment URLs
# Note: Vercel preview deployments (*.vercel.app) are automatically allowed by the CORS logic
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006,http://localhost:3001

# Web App URL (Frontend)
# Development: http://localhost:3000
# Production: https://marketplace-web-smoky.vercel.app
WEB_APP_URL=http://localhost:3000

# Application URL (for emails and links)
# Development: http://localhost:3000
# Production: https://marketplace-web-smoky.vercel.app
APP_URL=http://localhost:3000

# Frontend URL (for admin review links in emails)
# Should match your web app URL
FRONTEND_URL=http://localhost:3000

# Admin Settings
DEFAULT_COMMISSION_RATE=10.0
